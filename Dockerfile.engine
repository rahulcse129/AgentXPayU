# Margin engine (src/server/main.ts). Build from the repo root:
#   docker build -f Dockerfile.engine -t margin-engine .
# Which engine mode runs is chosen at start time by ENGINE_SCRIPT (see deploy/entrypoint.mjs).
FROM node:22-bookworm-slim

WORKDIR /app

# tsx (a devDependency) runs the TypeScript sources directly, so install dev deps too.
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund && npm cache clean --force

COPY tsconfig.json ./
COPY src ./src
COPY deploy ./deploy
# The engine reads these from its working directory for the proof badge (/api/meta).
COPY sim-report.json sabotage-report.json ./

# /app/data holds the SQLite run ledgers and Metal mandate credentials; in AWS it is an EFS mount.
RUN mkdir -p /app/data/ledgers /app/data/mandates && chown -R node:node /app/data

USER node
ENV PORT=4100 \
    MARGIN_LEDGER_DIR=/app/data/ledgers \
    METAL_MANDATE_DIR=/app/data/mandates \
    ENGINE_SCRIPT=engine:offline
EXPOSE 4100

CMD ["node", "deploy/entrypoint.mjs"]
