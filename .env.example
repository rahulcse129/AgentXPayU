# Margin configuration. Copy to .env and fill in. Never commit .env.

# mock (default): every rail mocked, runs offline with no keys. live: Airwallex sandbox + Metal testnet.
MODE=mock

# --- Airwallex sandbox (card holds) ---------------------------------------
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com
# Only if your scoped key is linked to more than one account: the account ID to act as (x-login-as).
AIRWALLEX_LOGIN_AS=
# Only for scripted sandbox runs and contract tests: a test card payment_method object as JSON.
# Empty: npm run smoke:airwallex uses Airwallex's published always-succeed sandbox Visa card.
# The real demo collects cards with Airwallex Drop-in / Elements; no card data touches our server.
AIRWALLEX_TEST_PAYMENT_METHOD=

# --- Metal testnet (x402 payments and mandates) ---------------------------
# Pinned: @metalntwx/metal-agent@0.3.3, @metalntwx/metal-pay@0.3.4. Accounts made on older versions must be recreated.
# Testnet needs your own RPC endpoint from https://console-testnet.metalntwx.com
METAL_RPC_URL=
# Agent key (hex). Testnet only; treat as a secret anyway.
METAL_PRIVATE_KEY=

# --- Clearing -------------------------------------------------------------
# emulator (default, SIMULATED) | live (refuses to start: not available on testnet) | off
# Read by clearingFromEnv() (src/clearing/config.ts). The demo, dashboard and sim currently always use
# the emulator, since it is the only implementation; they will read this once a live adapter exists.
CLEARING_MODE=emulator

# --- Agent ----------------------------------------------------------------
# The LLM only grades answers, phrases feed lines and writes report text.
# It never sees prices, budgets or holds. No key: npm run demo stays offline and deterministic.
# npm run demo reads .env (not this file) automatically. Put real keys in .env only;
# this file is committed.
#
# Gemini (Google AI Studio key). Used when set. GOOGLE_API_KEY also works.
GEMINI_API_KEY=
# Claude. Used when no Gemini key is set (or with LLM_PROVIDER=anthropic). ANTHROPIC_API_KEY also works.
LLM_API_KEY=
# Optional: force gemini | anthropic
LLM_PROVIDER=
# Optional model override (defaults: gemini-3.5-flash-lite, claude-opus-5-5).
# gemini-3.8-flash allows only 20 requests/day on the free tier; one demo run makes ~17.
LLM_MODEL=
# Optional cap on LLM calls per run. A rate-limit or quota error turns the LLM off for the run either way.
LLM_MAX_CALLS=

# --- Providers ------------------------------------------------------------
# Mock x402 provider server (npm run providers)
PROVIDERS_URL=http://localhost:4021
# Multiplies the mock providers' simulated latency on that server (1 = real-time)
LATENCY_SCALE=

# --- Dashboard (npm run engine / npm run dashboard) -----------------------
# Engine server port is PORT (default 4100). Set DASHBOARD_LLM=off, or use npm run engine:offline,
# to keep the LLM off even when a key is set (each dashboard run costs ~17 LLM calls).
DASHBOARD_LLM=
# Fraction of each provider's latency the engine actually waits, so the demo is watchable (default 0.6; 0 = no waiting)
PACE_SCALE=
# How long a hold-increase prompt waits before it counts as a decline (default 30000 ms)
APPROVAL_TIMEOUT_MS=
# Where the dashboard finds the engine. Read at build time: rebuild the dashboard after changing it.
NEXT_PUBLIC_ENGINE_URL=http://localhost:4100
