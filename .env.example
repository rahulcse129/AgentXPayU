# Margin configuration. Copy to .env and fill in. Never commit .env.

# mock (default): every rail mocked, runs offline with no keys. live: Airwallex sandbox + Metal testnet.
MODE=mock

# --- Airwallex sandbox (card holds) ---------------------------------------
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_BASE_URL=https://api-demo.airwallex.com
# Only for scripted sandbox runs and contract tests: a test card payment_method object as JSON.
# The real demo collects cards with Airwallex Drop-in / Elements; no card data touches our server.
AIRWALLEX_TEST_PAYMENT_METHOD=

# --- Metal testnet (x402 payments and mandates) ---------------------------
# Pinned: @metalntwx/metal-agent@0.3.3, @metalntwx/metal-pay@0.3.4. Accounts made on older versions must be recreated.
# Testnet needs your own RPC endpoint from https://console-testnet.metalntwx.com
METAL_RPC_URL=
# Agent key (hex). Testnet only; treat as a secret anyway.
METAL_PRIVATE_KEY=

# --- Clearing -------------------------------------------------------------
# emulator (default, SIMULATED) | live (refuses to start: not available on testnet) | off
CLEARING_MODE=emulator

# --- Agent ----------------------------------------------------------------
# The LLM only grades answers, phrases feed lines and writes report text.
# It never sees prices, budgets or holds. No key: npm run demo stays offline and deterministic.
# npm run demo reads .env (not this file) automatically. Put real keys in .env only;
# this file is committed.
#
# Gemini (Google AI Studio key). Used when set.
GEMINI_API_KEY=
# Claude. Used when no Gemini key is set (or with LLM_PROVIDER=anthropic).
LLM_API_KEY=
# Optional: force gemini | anthropic
LLM_PROVIDER=
# Optional model override (defaults: gemini-3.5-flash-lite, claude-opus-5-5).
# gemini-3.8-flash allows only 20 requests/day on the free tier; one demo run makes ~17.
LLM_MODEL=
# Optional cap on LLM calls per run. A rate-limit or quota error turns the LLM off for the run either way.
LLM_MAX_CALLS=

# --- Providers ------------------------------------------------------------
# Mock x402 provider server (npm run providers)
PROVIDERS_URL=http://localhost:4021
