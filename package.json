{
  "name": "margin",
  "version": "0.1.0",
  "private": true,
  "description": "Inference sourcing agent that buys AI work by live price and never charges past the customer's hold.",
  "type": "module",
  "scripts": {
    "check": "npm run typecheck && npm test && npm run sim && npm run sim:sabotage",
    "test": "node --no-warnings --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "sim": "node --no-warnings --import tsx src/sim/run.ts",
    "sim:sabotage": "node --no-warnings --import tsx src/sim/run.ts --runs=2000 --sabotage=all",
    "demo": "node --no-warnings --env-file-if-exists=.env --import tsx src/sim/demo.ts",
    "providers": "node --no-warnings --import tsx src/providers/server.ts",
    "engine": "node --no-warnings --env-file-if-exists=.env --import tsx src/server/main.ts",
    "engine:offline": "node --no-warnings --import tsx src/server/main.ts --no-llm",
    "dashboard:install": "npm --prefix apps/dashboard install",
    "dashboard:build": "npm --prefix apps/dashboard run build",
    "dashboard": "npm --prefix apps/dashboard run start"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@google/genai": "2.32.0",
    "@metalntwx/metal-agent": "0.3.3",
    "@metalntwx/metal-pay": "0.3.4",
    "viem": "2.57.13"
  }
}
